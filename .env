# mineru 配置文件位置
# MINERU_TOOLS_CONFIG_JSON="config/magic-pdf.json"

# minio配置
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="xt0109"
MINIO_SECURE="false"
MINIO_OUTPUT_BUCKET="xt0116"
UPLOAD_BUCKET="xt0116"

# 硬件相关的配置
MINIMUM_GPU_MEMORY=4294967296
MAX_CURRENT_WORKER=1
MAX_QUEUING_TASKS=20
# 在这里指定cuda设备的编号
DEFAULT_CUDA_DEVICE=5
# Redis信息
USE_INDEPENDENT_REDIS="false"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
