# mineru 配置文件位置
# MINERU_TOOLS_CONFIG_JSON="config/magic-pdf.json"

# minio配置
MINIO_ENDPOINT="101.133.138.164:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="chinaunicum"
MINIO_BUCKET_NAME="upload"
MINIO_SECURE="false"
MINIO_OUTPUT_BUCKET="another-output"
UPLOAD_BUCKET="upload"

# 硬件相关的配置
MINIMUM_GPU_MEMORY=4294967296
MAX_CURRENT_WORKER=1
MAX_QUEUING_TASKS=20
# Redis信息,默认使用自带的嵌入式redis
USE_INDEPENDENT_REDIS="true"
# 不能使用localhost，因为redis不在容器内部
REDIS_HOST="redis"
# 用一个非默认端口号
REDIS_PORT=16379
# 用一个非默认数据库
REDIS_DB=11
# 密码
REDIS_PASSWORD="wcfsfkfj"


# 给docker-compose.yml中的vllm服务指定GPU
CUDA_VISIBLE_DEVICES=0,1
# 使用新的设备指定变量
INFERENCE_DEVICES=0
# 指定GPU显存用量
VLLM_GPU_MEMORY_UTILIZATION=0.6
# 指定python路径
# npu环境使用默认配置
# PYTHON_PATH=/app/.venv/bin/python
# CELERY_PATH=/app/.venv/bin/celery
API_SERVICE_PORT=5116

# OSS 信息密钥
OSS_CIPHER_KEY="unicom1033"
